# Server-only admin UIDs (Kakao user id == Firebase Auth uid after Custom Token).
# Comma-separated. Never put this in the Flutter app.
# Prefer Auth custom claims admin:true long-term; this param is the bootstrap list.
#
# Deploy example:
#   firebase deploy --only functions
#   # Set param when prompted, or:
#   firebase functions:secrets:set  # (not used — ADMIN_UIDS is a string param)
#
# With params file / CLI:
#   firebase functions:config:export  # legacy — prefer .env for emulator
#
# Emulator (.env in functions/):
#   ADMIN_UIDS=1234567890,9876543210
ADMIN_UIDS=
