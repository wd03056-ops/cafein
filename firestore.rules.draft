rules_version = '2';
// ===============================================================
// CAFEIN Firestore Rules — PHASE 2 DRAFT (DO NOT DEPLOY YET)
// ===============================================================
//
// Premise:
//   Firebase Auth Custom Token uid == verified Kakao user id.
//   request.auth.uid is the app user id.
//
// Status:
//   Prototype for review. Live project still uses open firestore.rules.
//   Deploy only after Custom Token is mandatory and Emulator/device tests pass.
//   2026-03: BLOCKER fixes — notification isRead, comment content edit,
//   nickname via nicknames get only; usageCount ±1.
//   Poll voting: client engagement vote removed; Cloud Function castVote only.
//   Topic usageCount: client update denied; post triggers + topic_usage_ledger.
//   Author post update: cannot change poll/pollVoters/likedBy (editPostPoll CF).
//   Engagement like: likedBy affectedKeys only request.auth.uid.
//
// Assumed models (ownership fields — code-verified):
//
// users/{kakaoUid}
//   kakaoUserId, kakaoNickname, nickname, profileImage, email,
//   fcmToken, fcmTokens[], notificationSettings{comment,reply,like},
//   createdAt, updatedAt
//
// users/{uid}/moderation_actions/{reportId}  — SERVER ONLY (client deny)
//   actionType, targetUserId, reportId, createdAt, reviewedBy, adminNote, ...
//
// nicknames/{nickname}: uid, nickname, updatedAt
// topics/{id}: name, nameKey, usageCount, createdAt, updatedAt
// topic_names/{nameKey}: topicId, name, updatedAt
//
// posts/{postId}:
//   content, authorId, authorNickname, nickname, authorProfileImage,
//   experience, cafeType, likeCount, commentCount, likedBy{uid:true},
//   poll, pollVoters{uid:optionId}, tags, topicId, topicName,
//   authorWithdrawn, createdAt, updatedAt
//
// posts/{postId}/comments/{commentId}:
//   content, authorId, authorNickname, authorProfileImage, experience,
//   cafeType, likeCount, likedBy, authorWithdrawn, createdAt, updatedAt
//
// posts/{postId}/likes/{uid}: userId, postId, kakaoUserId, createdAt
// posts/.../comments/{cid}/likes/{uid}: userId, postId, commentId, kakaoUserId, createdAt
// posts/{postId}/poll_votes/{uid}: legacy optionId (read/cascade only)
//
// reports/{reporterId}_{targetType}_{targetId}:
//   reporterId, targetType, targetId, targetAuthorId, reason, parentPostId?,
//   status, action, reporterNotified, reportedUserNotified,
//   reviewedBy, reviewedAt, adminNote, createdAt, updatedAt
//
// blocks/{blockerId}_{blockedUserId}: blockerId, blockedUserId, createdAt
// notifications/{id}: recipientUserId, actorUserId, type, ... (CF writes)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.uid.size() > 0;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == resource.data[field];
    }

    function authorUnchanged() {
      return unchanged('authorId');
    }

    // Post author (for cascade delete of foreign likes/comments).
    function isPostAuthor(postId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId
          == request.auth.uid;
    }

    // Keys changed between existing and incoming doc.
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Admin / claims (NOT wired yet) ----
    // When custom claims land: return request.auth.token.admin == true;
    // Until then, treat as false so client admin UI cannot bypass Rules.
    function isAdmin() {
      return false;
    }

    // Moderation fields on reports — client must never set/change these
    // except initial create defaults (handled in create rule).
    function reportModerationKeys() {
      return [
        'status', 'action', 'reviewedBy', 'reviewedAt', 'adminNote',
        'reporterNotified', 'reportedUserNotified'
      ];
    }

    // ===========================================================
    // users/{userId}
    // ===========================================================
    match /users/{userId} {
      // Authenticated profile enrich (comments). No public read (email PII).
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isUser(userId)
        && request.resource.data.kakaoUserId == userId
        && !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data);

      allow update: if isUser(userId)
        && unchanged('kakaoUserId')
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('isAdmin' in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if isUser(userId);

      // Warning history — CLIENT DENY. Write via Admin SDK / callable CF.
      match /moderation_actions/{actionId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }
    }

    // ===========================================================
    // nicknames/{nickname}
    // ===========================================================
    match /nicknames/{nickname} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ===========================================================
    // topics / topic_names
    // ===========================================================
    match /topics/{topicId} {
      allow read: if true; // guest topic picker / popular

      // Create only with usageCount == 0. Increments = CF triggers / Admin SDK.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['name', 'nameKey', 'usageCount'])
        && request.resource.data.usageCount is int
        && request.resource.data.usageCount == 0;

      allow update: if false;
      allow delete: if false;
    }

    match /topic_names/{nameKey} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['topicId', 'name']);

      allow update: if isSignedIn()
        && unchanged('topicId');

      allow delete: if false;
    }

    // Server-only ledger for topic usageCount idempotency.
    match /topic_usage_ledger/{postId} {
      allow read, write: if false;
    }

    // ===========================================================
    // posts/{postId}
    // ===========================================================
    match /posts/{postId} {
      allow read: if true; // guest feed / detail

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;

      // Owner: content / topic / withdrawal anonymize.
      // Poll + pollVoters + voteCount: editPostPoll / castVote (Admin SDK) only.
      // Others: like / commentCount only.
      allow update: if isSignedIn() && (
        (
          resource.data.authorId == request.auth.uid
          && authorUnchanged()
          && unchanged('likedBy')
          && unchanged('pollVoters')
          && unchanged('poll')
          && !affectedKeys().hasAny(['likeCount', 'commentCount'])
        )
        || isEngagementLikeUpdate()
        || isEngagementCommentCountUpdate()
      );

      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      function likedByBefore() {
        return resource.data.keys().hasAny(['likedBy'])
          ? resource.data.likedBy
          : {};
      }

      function likedByAfter() {
        return request.resource.data.keys().hasAny(['likedBy'])
          ? request.resource.data.likedBy
          : {};
      }

      // Exactly one likedBy key may change: the signed-in user.
      function onlyOwnLikedByKeyChanged() {
        let changed = likedByAfter()
          .diff(likedByBefore())
          .affectedKeys();
        return changed.size() == 1
          && changed.hasOnly([request.auth.uid]);
      }

      function isEngagementLikeUpdate() {
        return affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt'])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.likeCount is int
          && onlyOwnLikedByKeyChanged()
          && (
            request.resource.data.likeCount == resource.data.likeCount + 1
            || request.resource.data.likeCount == resource.data.likeCount - 1
          );
      }

      function isEngagementCommentCountUpdate() {
        return affectedKeys().hasOnly(['commentCount', 'updatedAt'])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.commentCount is int
          && (
            request.resource.data.commentCount == resource.data.commentCount + 1
            || request.resource.data.commentCount
              == resource.data.commentCount - 1
          );
      }

      // ---- likes/{userId} ----
      match /likes/{userId} {
        allow read: if true;

        allow create: if isUser(userId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.kakaoUserId == request.auth.uid
          && request.resource.data.postId == postId;

        allow update: if false;

        // Own unlike OR post author cascade on deletePost.
        allow delete: if isUser(userId) || isPostAuthor(postId);
      }

      // ---- legacy poll_votes/{userId} ----
      match /poll_votes/{userId} {
        allow get: if isUser(userId);
        allow list: if isPostAuthor(postId);
        allow create, update: if false;
        allow delete: if isUser(userId) || isPostAuthor(postId);
      }

      // ---- comments/{commentId} ----
      match /comments/{commentId} {
        allow read: if true;

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.likeCount == 0;

        // Owner: content edit OR withdrawal anonymize. Others: likeCount only.
        allow update: if isSignedIn() && (
          (
            resource.data.authorId == request.auth.uid
            && authorUnchanged()
            && unchanged('createdAt')
            && unchanged('postId')
            && unchanged('likeCount')
            && (
              affectedKeys().hasOnly(['content', 'updatedAt'])
              || affectedKeys().hasOnly([
                'authorNickname', 'authorProfileImage', 'authorWithdrawn',
                'updatedAt'
              ])
            )
          )
          || isCommentLikeCountUpdate()
        );

        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid
          || isPostAuthor(postId)
          || isAdmin()
        );

        function isCommentLikeCountUpdate() {
          return affectedKeys().hasOnly(['likeCount', 'likedBy', 'updatedAt'])
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.likeCount is int
            && onlyOwnCommentLikedByKeyChanged()
            && (
              request.resource.data.likeCount == resource.data.likeCount + 1
              || request.resource.data.likeCount == resource.data.likeCount - 1
            );
        }

        function commentLikedByBefore() {
          return resource.data.keys().hasAny(['likedBy'])
            ? resource.data.likedBy
            : {};
        }

        function commentLikedByAfter() {
          return request.resource.data.keys().hasAny(['likedBy'])
            ? request.resource.data.likedBy
            : {};
        }

        function onlyOwnCommentLikedByKeyChanged() {
          let changed = commentLikedByAfter()
            .diff(commentLikedByBefore())
            .affectedKeys();
          return changed.size() == 1
            && changed.hasOnly([request.auth.uid]);
        }

        match /likes/{userId} {
          allow read: if true;

          allow create: if isUser(userId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kakaoUserId == request.auth.uid;

          allow update: if false;

          allow delete: if isUser(userId)
            || (isSignedIn()
              && get(/databases/$(database)/documents/posts/$(postId)/comments/$(commentId))
                  .data.authorId == request.auth.uid)
            || isPostAuthor(postId);
        }
      }
    }

    // ===========================================================
    // reports/{reportId}
    // ===========================================================
    match /reports/{reportId} {
      // Own reports only (listMyReports / withdraw). Admin list → CF later.
      allow read: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'reporterId', 'targetType', 'targetId', 'reason', 'status', 'action'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.action == 'none'
        && request.resource.data.reporterNotified == false
        && request.resource.data.reportedUserNotified == false;

      // Reporter may refresh reason (merge set). Cannot touch moderation fields.
      // Admin client updates denied until isAdmin() / CF callable exists.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.reporterId == request.auth.uid
          && unchanged('reporterId')
          && unchanged('targetType')
          && unchanged('targetId')
          && unchanged('targetAuthorId')
          && !affectedKeys().hasAny(reportModerationKeys())
        );

      allow delete: if isSignedIn()
        && resource.data.reporterId == request.auth.uid;
    }

    // ===========================================================
    // blocks/{blockId}
    // ===========================================================
    match /blocks/{blockId} {
      allow read: if isSignedIn()
        && resource.data.blockerId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockerId
          != request.resource.data.blockedUserId;

      allow update: if false;

      allow delete: if isSignedIn()
        && resource.data.blockerId == request.auth.uid;
    }

    // ===========================================================
    // notifications/{notificationId}
    // Create = Cloud Functions (Admin SDK).
    // Client: own read / isRead+updatedAt only / delete.
    // ===========================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientUserId == request.auth.uid;

      allow create: if false;

      // Recipient may mark read only — no message / actor / type / ids / TTL.
      allow update: if isSignedIn()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.recipientUserId == request.auth.uid
        && affectedKeys().hasOnly(['isRead', 'updatedAt'])
        && unchanged('recipientUserId')
        && unchanged('actorUserId')
        && unchanged('type')
        && unchanged('message')
        && unchanged('postId')
        && unchanged('commentId')
        && unchanged('createdAt')
        && unchanged('expireAt')
        && unchanged('postPreview')
        && unchanged('commentPreview')
        && unchanged('actorNickname')
        && request.resource.data.isRead is bool;

      allow delete: if isSignedIn()
        && resource.data.recipientUserId == request.auth.uid;
    }
  }
}
